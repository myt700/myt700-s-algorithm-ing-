找升序三元组的数量：https://www.luogu.com.cn/problem/P1637
这个题的核心思路是，你要知道怎么去找升序三元组
用一个数组来维护升序二元组的数量
根据自己的变化更新即可
用一个数组来维护升序三元组的数量
根据二元组数量的变化来跟新自己的变化
那么因为是单点修改+区间查询
所以可以用树状数组
#include<bits/stdc++.h>
using namespace std;
const int N = 30001;
const int V = 100005;
int arr[N];
using ll = long long;
ll tree1[V];
// 维护信息 : 课上讲的up1数组
// tree1不是up1数组，是up1数组的树状数组
ll tree2[V];
// 维护信息 : 课上讲的up2数组
// tree2不是up2数组，是up2数组的树状数组
int n;
#define lowbit(x) ((x) & (-x))
void add(ll tree[],int i,ll c){
    while(i <= V){
        tree[i] += c;
        i += lowbit(i);
    }
}
ll sum(ll tree[],int i){
    ll ans = 0;
    while(i > 0){
        ans += tree[i];
        i -= lowbit(i);
    }
    return ans;
}
int main(){
    cin >> n;
    for(int i = 1;i <= n; i++){
        cin >> arr[i];
    }
    ll res = 0;
    for(int i = 1;i <= n; i++){
        if(arr[i] > 1){
            res += sum(tree2,arr[i] - 1);
        }
        add(tree1,arr[i],1);
        if(arr[i] > 1){
            add(tree2,arr[i],sum(tree1,arr[i]-1));
        }
    }
    cout << res << "\n";
    return 0;
}
