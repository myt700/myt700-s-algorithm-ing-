    while(x > 0){
        ans += tree[x];
        x -= lowbit(x);
    }
    return ans;
}
int main(){
    cin >> n;
    int m; cin >> m;
    for(int i = 1;i <= n; i++){
        int x; cin >> x;
        updata(i,x);
        updata(i + 1, -x);
