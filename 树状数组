单点修改 + 范围查询
1.add(x,v):
不断给x加v，然后x=x加上x最右边的1，直到达到最大的n
2.query(l,r):
sum[r] - sum[l-1]（因为是从1开始的）
sum:
不断ans+=tree[x],然后x=x减去x最右边的1，直至0,（不能等于0，因为会越界）
#include<bits/stdc++.h>
using namespace std;
const int maxn = 5e5 + 5;
#define lowbit(x) ((x) & (-x))
int n;
int tree[maxn];
void updata(int x,int v){
    while(x <= n){
        tree[x] += v;
        x += lowbit(x);
    }
}
int sum(int x){
    int ans = 0;
    while(x > 0){
        ans += tree[x];
        x -= lowbit(x);
    }
    return ans;
}
int main(){
    int m;
    cin >> n >> m;
    for(int i = 1;i <= n; i++){
        int val; cin >> val;
        updata(i, val);
    }
    while(m--){
        int op; cin >> op;
        if(op == 1){
            int x,v; cin >> x >> v;
            updata(x, v);
        }else{
            int l,r;
            cin >> l >> r;
            cout << sum(r) - sum(l - 1) << "\n";
        }
    }
    return 0;
}

2.范围增加+单点查询
原始数组：[3 2 7 6 2 5]
差分数组：[3 -1 5 -1 -4 3]
用差分数组构建树状数组
https://www.luogu.com.cn/problem/P3368
#include<bits/stdc++.h>
using namespace std;
#define lowbit(x) ((x) & (-x))
const int maxn = 5e5 + 5;
int tree[maxn];
int n;
void updata(int x,int v){
    while(x <= n){
        tree[x] += v;
        x += lowbit(x);
    }
}
int sum(int x){
    int ans = 0;
    while(x > 0){
        ans += tree[x];
        x -= lowbit(x);
    }
    return ans;
}
int main(){
    cin >> n;
    int m; cin >> m;
    for(int i = 1;i <= n; i++){
        int x; cin >> x;
        updata(i,x);
        updata(i + 1, -x);
    }
    while(m--){
        int op; cin >> op;
        if(op == 1){
            int l,r,v; cin >> l >> r >> v;
            updata(l,v);
            updata(r+1,-v);
        }else{
            int x; cin >> x;
            cout << sum(x) << "\n";
        }
    }
    return 0;
}
