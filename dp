#include<bits/stdc++.h>
using namespace std;
const int maxn = 1e4 + 10;
const int mod = 1e9 + 7;
int n,w;
int a[maxn];
int dp[maxn];
using ll = long long;
int main(){
    cin >> n >> w;
    for(int i = 1;i <= n; i++) cin >> a[i];
    memset(dp,-1,sizeof(dp));
    dp[0] = 1;
    for(int j = 1;j <= w; j++){
        dp[j] = 0;
        for(int i = 1;i <= n; i++){
            if(j >= a[i]){
                dp[j] = (dp[j] + dp[j - a[i]]) % mod;
            }
        }
    }
    cout << dp[w] << "\n";
    return 0;
}
