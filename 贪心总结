https://leetcode.cn/problems/largest-number/
给一堆字符串，要求字符串组合起来的字典序最小
如果 ab <= ba 那就ab
如果 ab > ba 那就ba
class Solution {
public:
    string largestNumber(vector<int>& nums) {
        int n = nums.size();
        vector<string> s(n);
        for(int i = 0;i < n; i++){
            s[i] = to_string(nums[i]);
        }
        sort(s.begin(),s.end(),[](const string& a,const string& b){
            return (a + b) > (b + a);
        });
        if(s[0] == "0"){
            return "0";
        }
        string ans = "";
        for(auto x : s){
            ans += x;
        }
        return ans;
    }
};

https://leetcode.cn/problems/two-city-scheduling/
多个费用：按哪个费用排序？
假设刚开始都用第一种费用
那这样的话换到其他费用的代价就是：其他费用-第一种费用
然后就按代价费用排序
class Solution {
public:
    int twoCitySchedCost(vector<vector<int>>& costs) {
        int sum = 0;
        int n = costs.size();
        vector<int> arr(n);
        for(int i = 0;i < n; i++){
            sum += costs[i][0];
            arr[i] = costs[i][1] - costs[i][0];
        }
        sort(arr.begin(),arr.end());
        int m = n/2;
        for(int i = 0;i < m; i++){
            sum += arr[i];
        }
        return sum;
    }
};

吃掉n个橘子的最少天数
能凑整倍数就凑整倍数
那至于凑哪种，就看哪种更小
https://leetcode.cn/problems/minimum-number-of-days-to-eat-n-oranges/
class Solution {
public:
    unordered_map<int,int> dp;
    int minDays(int n) {
        //n=1 一天吃完
        //n>=1 批量吃（按比例）
        if(n<=1){
            return n;
        }
        if(dp.find(n)!=dp.end()){
            return dp[n];
        }
        int ans=min(n%2+1+minDays(n/2),n%3+1+minDays(n/3));
        dp[n]=ans;
        return ans;
    }
};


